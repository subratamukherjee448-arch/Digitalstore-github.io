# Environment Variables
# Copy this to .env.local and fill in your values

# Database (SQLite - auto created)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Razorpay (Test Mode)
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"
# This is the same as RAZORPAY_KEY_ID, exposed to the browser for Razorpay Checkout SDK
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

# Email (SMTP - optional, uses console log fallback)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="store@collegedigital.com"

# File Storage
STORAGE_PATH="./storage"

# Download Link Settings
DOWNLOAD_EXPIRY_HOURS="24"
DOWNLOAD_MAX_COUNT="3"
